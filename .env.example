# SO-UMI rig settings. Copy to .env (git-ignored) and fill in for your setup.
# Only needed for the parts that talk to the rig PC (viewer/server.py --rig/--tunnel, real/run.py,
# umi/touch_calib.py). Converting demos (umi/convert.py, umi/to_robot.py) needs none of this.
# Real environment variables override this file.

# ssh host of the PC wired to the arms and cameras (an alias from ~/.ssh/config; key auth, no password prompt).
# The rig PC is assumed to be Windows with PowerShell as the ssh shell.
SOUMI_RIG_HOST=

# python.exe on the rig PC that has the arm drivers' dependencies (opencv, numpy, feetech servo SDK, ...)
SOUMI_RIG_PYTHON=python

# Rig folder holding the arm drivers (so101_real.py, safety.py, rt_control.py, rig.json).
# SO-UMI's rig scripts are uploaded to its umi\ subfolder, run logs go to runs\, and creating a file
# named STOP in it stops any run.
SOUMI_RIG_REAL_DIR=C:\robot\real

# Where viewer/rig/umi_capture.py writes recordings on the rig PC
SOUMI_RIG_DATA_DIR=C:\robot\umi_data

# Local ports forwarded over ssh: monitor.py's camera relay and umi_capture.py's HTTP API
SOUMI_MONITOR_PORT=8104
SOUMI_CAPTURE_PORT=8106

# Set these on the RIG PC (not here) if its cameras enumerate differently (DirectShow indices):
# SOUMI_CAM_OVERHEAD=1
# SOUMI_CAM_UMI=3
# SOUMI_CAM_ROBOT_WRIST=2
