.DS_Store
__pycache__/
*.pyc

# Private: rig settings, the recorder/studio, real-arm runner (only for iterating on our own rig)
.env
.env.example
viewer/
real/

# Camera captures and episodes (large, personal)
data/
/demo.mp4

# umi/: publish the estimation, calibration and trajectory optimization only
umi/*
!umi/README.md
!umi/convert.py
!umi/cube_calib.py
!umi/pivot_calib.py
!umi/table_touch.py
!umi/to_robot.py
!umi/trajopt.py

# sim/: publish only the arm model + scene that umi/to_robot.py plans on
sim/*
!sim/README.md
!sim/__init__.py
!sim/env.py
!sim/scene.py
!sim/cameras.py
!sim/squeeze_env.py
!sim/assets/
sim/assets/so101_camera_rig.pre_refit_20261113.json

# Calibration results fit one rig: keep the tools, checkerboards, README and the reference rig's example/
calibration/*
!calibration/README.md
!calibration/calibrate.py
!calibration/make_checkerboard.py
!calibration/checkerboard_9x6_25mm_a4.pdf
!calibration/checkerboard_9x6_25mm_letter.pdf
!calibration/example/
